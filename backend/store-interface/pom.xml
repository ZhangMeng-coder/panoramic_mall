<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.panoramic</groupId>
        <artifactId>panoramic-mall-backend</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>store-interface</artifactId>
    <packaging>jar</packaging>
    <name>store-interface</name>
    <description>store 内部契约：Feign 客户端 + 同源 DTO/VO（域与调用方共用同一份，禁止各自复制）</description>

    <!--
      ⚠ 只被「调用方（端 BFF）」与「被调用方（store 域）」依赖。
      域侧只用 dto/vo，api/ 包里的 Feign 客户端与 Feign 配置类不会被域注册
      （StoreFeignConfiguration 刻意不带 @Configuration/@Component，不参与组件扫描）。
    -->
    <dependencies>
        <!-- common 基座：BasePageVO / ValidationGroups / InternalApiErrorDecoder / LoginUser / UserContext -->
        <dependency>
            <groupId>com.panoramic</groupId>
            <artifactId>common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- @FeignClient / @SpringQueryMap / RequestInterceptor / ErrorDecoder（版本由父 POM BOM 管理） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!-- DTO 上的 jakarta.validation 注解 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 契约包，无启动类，跳过 repackage -->
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
