<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.panoramic</groupId>
        <artifactId>panoramic-mall-backend</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>trade-center</artifactId>
    <name>trade-center</name>
    <description>全景商城交易域（下沉纯域，本期仅持 trade_cart_item 购物车）</description>

    <dependencies>
        <!-- common 工具包（RespData/BaseEntity/BasePageVO/异常处理/安全链等） -->
        <dependency>
            <groupId>com.panoramic</groupId>
            <artifactId>common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 本域内部契约（Feign 客户端 + 同源 DTO/VO）：域侧只用 dto/vo，不扫描 api/ 里的 Feign 客户端 -->
        <dependency>
            <groupId>com.panoramic</groupId>
            <artifactId>trade-center-interface</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          ⚠ 本域是**唯一**依赖「别的域的 interface」的域（域间协作：下单要查 store 域的商品快照与扣库存）。
          这破了「各域只依赖自己的 <域>-interface」那条编译期守卫——那条守卫正是靠「引用别域类型会编译失败」
          生效的，本边一旦存在，守卫对本域失效。故它是**登记例外**，见 docs/contracts/cross-cutting.md 第 24 条。
          ⚠ 只加这一个：openfeign / loadbalancer / resilience4j 这些通道件已由 common 作普通依赖传出（R15），
          不需要在本 pom 再声明。
        -->
        <dependency>
            <groupId>com.panoramic</groupId>
            <artifactId>store-interface</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Nacos 服务发现 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <!-- Nacos 配置中心（spring.config.import 拉取共享 datasource-mysql / datasource-redis 配置） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <!--
          Seata 全局事务（版本由 spring-cloud-alibaba BOM 管理）。
          ⚠ 本域是**发起方（TM）+ 参与方（RM）**：@GlobalTransactional 落在 OrderCreateCoordinator#create，
          跨域那一半是 store 域的库存扣减 / 回补；配置见 Nacos 共享配置 seata.yml（cross-cutting 第 12 / 24 条）。
        -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-seata</artifactId>
        </dependency>
        <!-- MyBatis-Plus（Spring Boot 4 专用 starter，版本由父 POM 管理） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <!-- 分页插件依赖（需与 starter 同版本） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <!-- MySQL 驱动（版本由 Spring Boot BOM 管理） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
          ⚠ Redis：本域是全仓库唯一加载它的业务域（购物车加购去重 + 行数读穿透缓存）。
          它只被当缓存/提示用，不出现在任何鉴权链路上（域内仍然不鉴权、不碰 token、不查登录态），
          详见 config/CartRedisCache 的类注释与 docs/contracts/trade-center.md 第一节。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Jackson（Spring Boot 4 的 starter-web 不再传递包含，ObjectMapper 自动配置依赖它） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- Java 8 时间类型（LocalDateTime/LocalDate）序列化支持 -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!--
          测试依赖（JUnit 5 + AssertJ）。本期唯一目的：让订单领域模型能用单测验证（依据仓库根 todo.md 执行计划 D10）。
          版本由 spring-boot-starter-parent 管理；Spring Boot 4 的 parent 已带 surefire/failsafe 的 pluginManagement，
          故**不额外配 surefire**——配了反而会覆盖掉 parent 的版本与参数。
          ⚠ 测试一律纯 JUnit（不启 Spring）：trade-center 的 spring.config.import 不带 optional:，
          没有 Nacos 时上下文启动即失败，@SpringBootTest 不是可绕过的选项（见 D10）。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
